{
  "manifest_version": 3,
  "name": "Legal AI Companion",
  "version": "0.1.0",
  "description": "Демонстрационный помощник для интернет-версии системы ГАРАНТ.",
  "content_scripts": [
    {
      "matches": ["https://internet.garant.ru/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "legal-ai-companion@snetkov.ru",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
