{
  "name": "legal-ai-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:chromium && npm run build:firefox",
    "build:chromium": "vite build --mode chromium",
    "build:firefox": "vite build --mode firefox",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "latest",
    "jsdom": "29.1.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
